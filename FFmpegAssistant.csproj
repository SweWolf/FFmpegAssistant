<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\FFmpegAssistant.ico</ApplicationIcon>
    <Title>FFmpeg Assistant</Title>
    <AssemblyTitle>FFmpeg Assistant</AssemblyTitle>
    <Product>FFmpeg Assistant</Product>
    <Company>SweWolf Software</Company>
    <Authors>Uffe Peter Walderö</Authors>
    <Version>1.5.0</Version>
    <PackageIcon>FFmpegAssistant.png</PackageIcon>
    <Description>Downloads and saves video streams using FFmpeg, with real-time progress tracking and automatic episode naming.</Description>
    <RepositoryUrl>https://github.com/SweWolf/FFmpegAssistant</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources\FFmpegAssistant.ico" />
    <EmbeddedResource Include="Resources\FFmpegAssistant.ico" />
    <EmbeddedResource Include="Resources\FFmpegAssistant.png" />
    <!-- Embedded, not copied next to the exe: the single-file release ships only the exe -->
    <EmbeddedResource Include="Resources\*.wav">
      <LogicalName>Sounds/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Help > FFmpeg Assistant Help (F1), embedded for the same reason; HelpFiles.cs saves it to
         %AppData% to open it. Rebuild it from help.md with docs\build-help.cmd -->
    <EmbeddedResource Include="docs\help.html">
      <LogicalName>Help/help.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\FFmpegAssistant.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>